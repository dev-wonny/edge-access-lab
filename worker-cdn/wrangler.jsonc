{
    // worker이름
    "name": "flag-cdn-demo",
    "main": "index.js",
    "compatibility_date": "2026-09-23",
    // r2설정
    "r2_buckets": [
        {
            "binding": "FLAGS",
            "bucket_name": "edge-access-lab-flags"
        }
    ],
    // 라우팅 설정
    "routes": [
        {
            "pattern": "tunnel.devwonny.win/cdn/*",
            "zone_name": "devwonny.win"
        }
    ],
    // worker 로그 활성화 : /flag-cdn-demo/production/observability/invocations
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    }
}