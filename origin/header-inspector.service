[Unit]
Description=Edge Access Lab Header Inspector
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/edge-access-lab/origin
ExecStart=/usr/bin/python3 /home/ubuntu/edge-access-lab/origin/app.py
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
