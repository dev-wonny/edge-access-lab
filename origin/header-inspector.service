[Unit]
Description=Edge Access Lab Header Inspector
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/edge-access-lab/origin
ExecStart=/usr/bin/python3 /home/ubuntu/edge-access-lab/origin/app.py
# systemd가 ubuntu 소유의 /var/log/header-inspector 폴더를 만든다.
# ProtectSystem=strict로 쓰기를 제한해도 이 로그 폴더는 쓸 수 있다.
LogsDirectory=header-inspector
LogsDirectoryMode=0750
UMask=0027
# 앱에 로그 파일 경로를 환경변수로 전달한다.
Environment=APP_LOG_FILE=/var/log/header-inspector/app.log
# 표준 출력과 오류는 journalctl에서도 볼 수 있다.
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
